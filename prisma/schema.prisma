// Cliente Prisma para PostgreSQL. Los modelos de persistencia están pendientes.
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum Status {
  OPEN
  CLOSED
}
model Tickets {
  id String @id @default(uuid()) @db.Uuid
  title String
  description String
  priority Priority @default(MEDIUM)
  status Status @default(OPEN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
